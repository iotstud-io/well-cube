{
    "name": "well-cube-components",
    "components": [
        {
            "name": "AirPlus",
            "defaultExport": true,
            "description": "Component to display all the telemetry from a WellCube Air+ device.",
            "operationRequirements": [
                { "capabilityKey": "tvoc", "operationKey": "read", "optional": false },
                { "capabilityKey": "pm10", "operationKey": "read", "optional": false },
                { "capabilityKey": "pm25", "operationKey": "read", "optional": false },
                { "capabilityKey": "proximity_meters", "operationKey": "read", "optional": false },
                { "capabilityKey": "life_percent", "operationKey": "read", "optional": false },
                { "capabilityKey": "noise_db", "operationKey": "read", "optional": false },
                { "capabilityKey": "cct", "operationKey": "read", "optional": false },
                { "capabilityKey": "brightness_lux", "operationKey": "read", "optional": false },
                { "capabilityKey": "humidity", "operationKey": "read", "optional": false },
                { "capabilityKey": "temp_celcius", "operationKey": "read", "optional": false },
                { "capabilityKey": "co2", "operationKey": "read", "optional": false },
                { "capabilityKey": "timemstamp_unix", "operationKey": "read", "optional": false }
            ],
            "settings": [
                {
                    "name": "temperature_format",
                    "label": "Temperature Format",
                    "description": "Choose between Celsius and Fahrenheit.",
                    "default": "f",
                    "options": [
                        { "value": "c", "label": "Celsius" },
                        { "value": "f", "label": "Fahrenheit" }
                    ]
                },
                {
                    "name": "show_chart",
                    "label": "Show Chart",
                    "description": "Toggle to show or hide the Historical Data Chart.",
                    "default": true,
                    "options": [
                        { "value": true, "label": "Show" },
                        { "value": false, "label": "Hide" }
                    ]
                }
            ]
        },
        {
            "name": "RoomReadiness",
            "defaultExport": true,
            "description": "Component to display the readiness of a room based on WellCube sensors.",
            "capabilities": {
                "tvoc": "optional",
                "pm10": "optional",
                "pm25": "optional",
                "brightness_lux": "optional",
                "temp_celcius": "optional",
                "co2": "optional"
            },
            "operationRequirements": [
                { "capabilityKey": "tvoc", "operationKey": "read", "optional": false },
                { "capabilityKey": "pm10", "operationKey": "read", "optional": false },
                { "capabilityKey": "pm25", "operationKey": "read", "optional": false },
                { "capabilityKey": "brightness_lux", "operationKey": "read", "optional": false },
                { "capabilityKey": "temp_celcius", "operationKey": "read", "optional": false },
                { "capabilityKey": "co2", "operationKey": "read", "optional": false }
            ],
            "settings": [
                {
                    "name": "temperature_format",
                    "label": "Temperature Format",
                    "description": "Choose between Celsius and Fahrenheit.",
                    "default": "f",
                    "options": [
                        { "value": "c", "label": "Celsius" },
                        { "value": "f", "label": "Fahrenheit" }
                    ]
                }
            ]
        }
    ]
}
